{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["src/index.ts", "tests/**/*.test.ts"],
	"project": ["src/**/*.ts", "tests/**/*.ts"],
	"ignoreDependencies": ["@secretlint/secretlint-rule-preset-recommend", "@faker-js/faker"],
	"rules": {
		"types": "off"
	},
	"drizzle": false,
	"ignore": [
		"src/packages/schema/common.schema.ts",
		"src/app/auth/google/google.routes.ts",
		"src/app/auth/google/google.services.ts",
		"src/app/auth/discord/discord.routes.ts",
		"src/app/auth/discord/discord.services.ts",
		"src/app/auth/phone/phone.routes.ts",
		"src/app/auth/phone/phone.services.ts",
		"src/packages/configs/email.config.ts"
	],
	"ignoreIssues": {
		"src/packages/configs/**": ["exports", "types"],
		"src/packages/schema/**": ["exports", "types"]
	}
}
