# Server
NODE_ENV=development
HOST=localhost
PORT=7164
LOG_LEVEL=info

# REQUIRED in production: unique value, at least 32 characters.
# Generate one with: openssl rand -base64 48
APP_SECRET=

# Public URLs (optional). On Vercel these default from VERCEL_PROJECT_PRODUCTION_URL.
# SITE_ORIGIN=http://localhost:7164

# Frontend origins (optional)
# CLIENT_ORIGIN=http://localhost:3000
# CLIENT_ORIGINS=http://localhost:3000

# API
API_PREFIX=/api
API_VERSION=v1

# Rate limiting
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Request body size limit, in bytes
BODY_LIMIT_BYTES=1000000

# Security headers (CSP, HSTS, X-Frame-Options, ...)
ENABLE_SECURITY_HEADERS=true

# CSRF protection (double-submit cookie). Auth uses cookies, so this defaults to ON. A pure
# Bearer-token client is not vulnerable to CSRF and skips this check automatically. Cross-origin
# frontends fetch the token from GET /api/v1/csrf and echo it in the x-csrf-token header.
ENABLE_CSRF_PROTECTION=true

# Which proxy header carries the real client IP (rate limiting + session metadata).
# Trusting the wrong one lets clients forge their IP and dodge rate limits.
#   none       ignore forwarding headers (default; right for a directly exposed server)
#   vercel     x-vercel-forwarded-for / x-real-ip   (auto-selected when VERCEL is set)
#   cloudflare cf-connecting-ip
#   forwarded  rightmost x-forwarded-for entry (exactly ONE trusted proxy in front)
# TRUST_PROXY=none

# CORS (allows the origins in CLIENT_ORIGINS, with credentials for the CSRF cookie)
ENABLE_CORS=true
CLIENT_ORIGINS=http://localhost:3000

# Response compression. On Vercel this is usually redundant — their edge network already
# compresses responses — so leave this off there unless you've measured a benefit.
ENABLE_COMPRESSION=true

# One JSON log line per request (method, path, status, duration)
ENABLE_REQUEST_LOGGING=true

# Interactive API docs generated from route schemas, served at /openapi
ENABLE_SWAGGER=true

# Postgres — Supabase: Settings > Database > Connection string (URI).
# Used both by the app at runtime (src/packages/db/client.ts) and by
# `bun run db:push` / `db:generate` (drizzle-kit) to sync supabase/schema.sql.
DATABASE_URL=
# Hosted Postgres needs TLS (default true). Set false only for a local Postgres.
# DATABASE_SSL=true

# Auth — secrets for the JWTs this API issues itself (NOT Supabase Auth).
# Production REQUIRES two different values of 32+ characters each; the app refuses to boot otherwise.
# Generate with: openssl rand -base64 48
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=

# Lifetimes accept 30s / 15m / 12h / 30d.
AUTH_ACCESS_TOKEN_TTL=15m
# Session length with "remember me" / without it.
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_SHORT_SESSION_TTL=1d
# A just-rotated refresh token is tolerated this long (two tabs refreshing at once).
# Replaying it later revokes the whole session.
AUTH_REFRESH_REUSE_GRACE=10s

# Account lockout and session cap
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_DURATION=15m
AUTH_MAX_SESSIONS_PER_USER=10

# Cookies. lax is right when the frontend shares a site with the API. Use none ONLY when the
# frontend is on a different site (forces Secure). Set the domain to share cookies across
# subdomains, e.g. .example.com
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# Email flows. With true, sign-up issues no session until the email is verified and sign-in
# refuses unverified accounts. Needs a mail transport (see README "Email").
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_VERIFY_TOKEN_TTL=24h
AUTH_RESET_TOKEN_TTL=1h

# Mount the email auth routes at /api/v1/auth/email/*
ENABLE_EMAIL_AUTH=true
